# ---- core ----
RAILVISION_MODE=demo                 # demo | live   (live refuses all demo data)
RAILVISION_SECRET=change-me-64-hex   # keyed hashing of tokens/phone numbers; keep stable & secret
RAILVISION_DB=railvision.db
RAILVISION_APP_URL=https://railvision.example.in
RAILVISION_CORS_ORIGINS=
RAILVISION_RATE_PER_MIN=120
RAILVISION_ALLOW_SIGNUP=false        # live mode: issue tokens only via your admin process
RAILVISION_TICK_SECONDS=30
# ---- authorized rail data provider ----
RAILVISION_PROVIDER_CONFIG=config/provider.json
RAIL_PROVIDER_API_KEY=
# ---- WhatsApp Cloud API (official Meta) ----
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=                    # current version string from Meta docs, e.g. vNN.0
WA_TEMPLATE_NAME=                    # approved utility template (8 body params, see services/messages.py)
WA_TEMPLATE_LANG=en
WA_OBA_VERIFIED=false                # true only after Meta grants Official Business Account
# ---- Telegram (optional group/channel broadcast) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CHAT_ID=
# ---- email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# ---- Android push (Firebase Cloud Messaging v1) ----
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
# ---- optional LLM intent classifier (never used for live facts) ----
ANTHROPIC_API_KEY=
RAILVISION_LLM_MODEL=
# ---- announcements ----
RAILVISION_NEWS=true                 # PIB RSS + your official pages (+ X if a token is set)
X_BEARER_TOKEN=                      # official X API (pay-per-use); leave empty to skip X
X_DAILY_POST_BUDGET=60               # posts/day cap (~$0.005 each, checked Oct 2026)
