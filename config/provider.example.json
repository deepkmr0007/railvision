  "_README": "TEMPLATE ONLY. Every path and field name below is a PLACEHOLDER (UNVERIFIED). Replace them from your authorized provider's official documentation, set enabled=true, and export the key env var. Never point this at NTES/IRCTC pages.",
  "providers": [
    {
      "enabled": false,
      "source_id": "licensed-provider-1",
      "display_name": "Licensed Provider (fill in)",
      "official": false,
      "base_url": "https://api.example-licensed-provider.com/v1",
      "official_url": "https://enquiry.indianrail.gov.in/mntes/",
      "auth": {"type": "header", "name": "X-API-Key", "env": "RAIL_PROVIDER_API_KEY"},
