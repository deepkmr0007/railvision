      "timeout_s": 8,
      "max_retries": 2,
      "breaker_threshold": 4,
      "breaker_cooldown_s": 120,
      "success_path": null,
      "error_path": null,
      "capabilities": {"train_status": "REQUIRES THIRD-PARTY LICENSE", "train_route": "REQUIRES THIRD-PARTY LICENSE"},
      "endpoints": {
        "train_route": {"path": "/trains/{train_number}/route?date={date}", "ttl": 21600},
        "train_status": {"path": "/trains/{train_number}/live?date={date}", "ttl": 60}
      },
      "map": {
        "route": {"list": "data.stops", "code": "station_code", "name": "station_name", "km": "distance_km",
                  "day": "day", "arr": "arrival", "dep": "departure", "halt": null, "platform": "platform",
                  "train_name": "data.train_name"},
        "status": {"list": "data.stops", "code": "station_code", "day": "day", "delay": "delay_min", "halt": "is_halt",
                   "actual_arr": "actual_arrival", "actual_dep": "actual_departure",
                   "has_arrived": "arrived", "has_departed": "departed", "platform": "platform",
                   "updated_at": "data.last_updated", "position_station": "data.current.after_station",
                   "position_km_after": "data.current.km_after", "cancelled": "data.is_cancelled",
                   "diverted_route": "data.diverted_route"}
      }
    }
  ]
